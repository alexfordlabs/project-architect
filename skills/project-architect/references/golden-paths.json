        "plugin.surface": "skill+agents",
        "plugin.manifest": "plugin.json+marketplace.json",
        "plugin.distribution": "marketplace",
        "plugin.testing": "bash+python-harness",
        "plugin.lint": "shellcheck",
        "plugin.precommit": "gitleaks",
        "plugin.docs": "skill-references",
        "stack.ci.provider": "github-actions",
        "stack.license": "mit",
        "ai.enabled": true
      },
      "valid_through": "2026-12-31"
