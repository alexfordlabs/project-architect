      "decisions": {
        "project.type": "mobile_app",
        "stack.mobile.framework": "react-native",
        "stack.mobile.toolchain": "expo",
        "stack.mobile.language": "typescript",
        "stack.mobile.navigation": "expo-router",
        "stack.mobile.targets": "ios+android",
        "stack.backend.provider": "supabase",
        "stack.database.engine": "postgresql",
        "stack.auth.provider": "supabase-auth",
        "stack.build.provider": "eas",
        "stack.updates.strategy": "eas-update"
      },
      "valid_through": "2026-12-31"
    },
    {
      "id": "high_perf_api",
      "label": "High-performance API",
