        "stack.hosting.provider": "aws",
        "stack.observability": "opentelemetry"
      },
      "valid_through": "2026-12-31"
    },
    {
      "id": "pl_interpreter",
      "label": "Programming language: interpreter",
      "description": "A tree-walking interpreter for a new programming language, implemented in Rust with a hand-written lexer and recursive-descent parser, insta snapshot tests, criterion benchmarks, and an mdBook reference.",
      "decisions": {
        "project.type": "programming_language",
        "pl.kind": "interpreter",
        "pl.execution": "tree-walking",
        "stack.backend.language": "rust",
        "pl.lexer": "hand-written",
        "pl.parser": "recursive-descent",
        "pl.testing": "insta-snapshots",
        "pl.benchmarks": "criterion",
        "pl.docs": "mdbook",
        "stack.build.tool": "cargo",
        "stack.ci.provider": "github-actions"
      },
      "valid_through": "2026-12-31"
    },
    {
      "id": "cli_rust",
      "label": "CLI in Rust",
      "description": "A cross-platform command-line tool in Rust using clap for argument parsing, anyhow/thiserror for errors, insta + assert_cmd for tests, distributed via cargo-dist and a Homebrew tap.",
      "decisions": {
        "project.type": "cli",
        "stack.backend.language": "rust",
        "cli.arg_parser": "clap",
        "cli.error_handling": "anyhow+thiserror",
        "cli.config_format": "toml",
        "cli.testing": "insta+assert_cmd",
        "stack.build.tool": "cargo",
        "cli.distribution": "cargo-dist",
        "cli.package_manager": "homebrew",
        "stack.ci.provider": "github-actions",
        "cli.targets": "linux+macos+windows"
      },
      "valid_through": "2026-12-31"
    },
    {
      "id": "cc_plugin",
