{
  "schema_version": "4.0",
  "paths": [
    {
      "id": "modern_saas_2026",
      "label": "Modern SaaS (2026)",
      "description": "A multi-tenant SaaS web app on the 2026 default stack: Next.js + Tailwind on Vercel, a TypeScript backend over PostgreSQL with Drizzle, Stripe billing, and NextAuth sessions.",
      "decisions": {
        "project.type": "web_app",
        "stack.frontend.framework": "next.js",
        "stack.frontend.styling": "tailwind",
        "stack.backend.language": "typescript",
        "stack.backend.runtime": "node",
        "stack.database.engine": "postgresql",
        "stack.database.orm": "drizzle",
        "stack.hosting.provider": "vercel",
        "stack.payments.provider": "stripe",
        "stack.auth.provider": "next-auth"
      },
      "valid_through": "2026-12-31"
    },
    {
      "id": "ai_rag_app",
      "label": "AI / RAG application",
      "description": "A retrieval-augmented-generation app: FastAPI backend, a pgvector-backed PostgreSQL store, LangGraph orchestration over the Anthropic API, and a Next.js chat front end on Vercel.",
      "decisions": {
        "project.type": "web_app",
        "ai.enabled": true,
        "ai.provider": "anthropic",
        "ai.model": "claude-fable-5",
        "ai.orchestration": "langgraph",
        "ai.rag.vector_store": "pgvector",
        "ai.rag.embeddings": "voyage-3",
        "stack.frontend.framework": "next.js",
        "stack.backend.language": "python",
        "stack.backend.framework": "fastapi",
        "stack.database.engine": "postgresql",
        "stack.hosting.provider": "vercel"
      },
      "valid_through": "2026-12-31"
    },
    {
