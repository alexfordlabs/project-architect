{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alexfordlabs.com/schemas/adr-v4-frontmatter.json",
  "title": "v8 ADR Frontmatter (structured-MADR)",
  "type": "object",
  "required": [
    "type",
    "schema_version",
    "id",
    "title",
    "status",
    "date",
    "decision_makers",
    "plugin_version"
  ],
  "properties": {
    "type": {"const": "adr"},
    "schema_version": {"const": "4.0"},
    "id": {"type": "string", "pattern": "^\\d{4}$"},
    "title": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["Proposed", "Accepted", "Deprecated", "Superseded", "Rejected", "Reserved"]
    },
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "decision_makers": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "tags": {"type": "array", "items": {"type": "string"}},
    "phase": {"type": ["string", "null"]},
    "plugin_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "supersedes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^\\d{4}$"}
    },
    "superseded_by": {
      "type": "array",
      "items": {"type": "string", "pattern": "^\\d{4}$"}
    },
    "related": {
      "type": "array",
      "items": {"type": "string", "pattern": "^\\d{4}$"}
    },
    "risk": {"enum": ["low", "medium", "high"]},
    "audit": {"type": "object"}
  }
}
